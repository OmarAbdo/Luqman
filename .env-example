# Luqman configuration. Copy to `.env` and fill in what you need.
#
# NOTHING HERE IS REQUIRED for the core, proven functionality:
#   - daily price data comes from Yahoo Finance (no key)
#   - Fama-French factors come from the Ken French library (no key)
#   - volatility forecasting and both admitted factors need neither
#
# The keys below are only needed to re-run the experiments whose signals were
# tested and REJECTED (news sentiment, fundamentals, macro). See
# .refactor/dataset-plan.md for those verdicts.

# Default ticker for commands that take one (optional; defaults to AAPL)
TICKER=AAPL

# Financial Modeling Prep — fundamentals, earnings, analyst grades
# Free tier caps statement history at 5 periods.
FMP_API=

# Alpha Vantage — news sentiment, macro series, intraday bars
ALPHA_VANTAGE_API=

# Optional path overrides (default to ./data and ./experiments)
# LUQMAN_DATA_DIR=
# LUQMAN_EXPERIMENTS_DIR=

# Seed for reproducible runs (default 42)
# LUQMAN_SEED=42
